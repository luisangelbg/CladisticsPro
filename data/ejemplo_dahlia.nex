#NEXUS
[Dahlia (didáctico) — matriz SIMULADA para enseñar y probar CladisticsPro; los estados no se observaron en ejemplares]

BEGIN TAXA;
  DIMENSIONS NTAX=20;
  TAXLABELS 'Bidens pilosa' 'Cosmos bipinnatus' 'Dahlia macdougallii' 'Dahlia imperialis' 'Dahlia excelsa' 'Dahlia tenuicaulis' 'Dahlia campanulata' 'Dahlia linearis' 'Dahlia rupicola' 'Dahlia dissecta' 'Dahlia scapigera' 'Dahlia cardiophylla' 'Dahlia merckii' 'Dahlia moorei' 'Dahlia coccinea' 'Dahlia sherffii' 'Dahlia atropurpurea' 'Dahlia pinnata' 'Dahlia rudis' 'Dahlia australis';
END;

BEGIN CHARACTERS;
  TITLE 'Discretos';
  DIMENSIONS NCHAR=42;
  FORMAT DATATYPE=STANDARD MISSING=? GAP=- SYMBOLS="0 1 2 3";
  CHARSTATELABELS
    1 'Hábito' / 'herbáceo' 'sufrútice' arborescente 'epífito',
    2 'Raíces tuberosas' / ausentes presentes,
    3 Tallo / 'sólido' fistuloso,
    4 Entrenudos / 'no engrosados' 'engrosados en los nudos',
    5 'Tricomas del tallo' / ausentes presentes,
    6 'Tipo de tricoma del tallo' / simples glandulares,
    7 'Densidad de tricomas' / escasos densos,
    8 'División de la hoja' / simple pinnada bipinnada tripinnada,
    9 Hojas / 'sésiles' pecioladas,
    10 Raquis / 'sin alas' alado,
    11 'Margen del folíolo' / entero serrado crenado,
    12 'Ápice del folíolo' / agudo acuminado obtuso,
    13 'Hojas en roseta basal' / no 'sí',
    14 'Envés de la hoja' / glabro pubescente,
    15 'Nervación del folíolo' / pinnada 'palmeada desde la base',
    16 'Capítulos por rama' / solitarios 'de dos a cuatro' muchos,
    17 'Capítulos' / erectos nutantes,
    18 'Pedúnculo' / 'más corto que la hoja' 'más largo que la hoja',
    19 'Brácteas involucrales externas' / reflejas patentes adpresas,
    20 'Número de brácteas externas' / cinco 'ocho o más',
    21 'Forma de la bráctea externa' / ovada linear espatulada,
    22 'Brácteas internas' / libres 'connadas en la base',
    23 'Páleas' / persistentes caducas,
    24 'Flores liguladas' / ocho 'más de ocho',
    25 'Color de la lígula' / blanco rosado morado rojo,
    26 'Ápice de la lígula' / entero tridentado,
    27 'Lígula' / plana acanalada,
    28 'Corola del disco' / amarilla anaranjada morada,
    29 'Lóbulos de la corola' / glabros pilosos,
    30 Anteras / amarillas negras,
    31 'Ramas del estilo' / agudas obtusas,
    32 'Forma del aquenio' / oblanceolado linear,
    33 'Aquenio alado' / no 'sí',
    34 'Tipo de ala' / entera fimbriada,
    35 Vilano / ausente presente,
    36 'Tipo de vilano' / aristas escamas,
    37 'Número de aristas' / dos cuatro,
    38 'Superficie del aquenio' / lisa tuberculada,
    39 'Color del aquenio' / negro 'café' moteado,
    40 'Número cromosómico' / diploide tetraploide octoploide,
    41 'Látex' / ausente presente,
    42 'Disposición de las hojas' / opuestas verticiladas;
  MATRIX
    'Bidens pilosa'        00000--11010010101000000310001010-10001000
    'Cosmos bipinnatus'    000010010010000001211000300110010-10100000
    'Dahlia macdougallii'  310(01)0--100110(01)101120210010001??00-0--00000
    'Dahlia imperialis'    ?1100--2001100011020?1(01)1(01)1000000(01)-0--1?111
    'Dahlia excelsa'       21???--20011?00(01)1120?1(01)0110000000-0--00101
    'Dahlia tenuicaulis'   21100--2001?000010200100110000000-0--00101
    'Dahlia campanulata'   2?1(01)0--200110000??200100110000000-0--00100
